@{
    ViewData["Title"] = "File Manager Demo";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .demo-container {
            background: white;
            padding: 60px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 600px;
            width: 100%;
        }
        
        .demo-container h1 {
            margin: 0 0 16px 0;
            font-size: 32px;
            font-weight: 700;
            color: #111827;
        }
        
        .demo-container p {
            margin: 0 0 40px 0;
            font-size: 16px;
            color: #6b7280;
            line-height: 1.6;
        }
        
        .form-section {
            margin-bottom: 40px;
            text-align: left;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }
        
        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
            box-sizing: border-box;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        .form-input:read-only {
            background: #f9fafb;
            cursor: not-allowed;
        }
        
        .selected-image-preview {
            margin-top: 12px;
            text-align: center;
        }
        
        .selected-image-preview img {
            max-width: 100%;
            max-height: 200px;
            border-radius: 8px;
            border: 2px solid #e5e7eb;
        }
        
        .open-manager-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 16px 40px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            width: 100%;
        }
        
        .open-manager-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }
        
        .open-manager-btn:active {
            transform: translateY(0);
        }
        
        .features {
            margin-top: 40px;
            padding-top: 40px;
            border-top: 1px solid #e5e7eb;
            text-align: left;
        }
        
        .features h3 {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
            margin: 0 0 16px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .features ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .features li {
            padding: 8px 0;
            color: #6b7280;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .features li:before {
            content: "✓";
            color: #10b981;
            font-weight: bold;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="demo-container">
        <h1>Dosya Yöneticisi</h1>
        <p>Dosyalarınızı kolayca yönetin, klasörler oluşturun ve görselleri düzenleyin.</p>
        
        <div class="form-section">
            <div class="form-group">
                <label class="form-label">Seçilen Resim URL</label>
                <input type="text" id="ImageURL" class="form-input" placeholder="Dosya seçmek için butona tıklayın..." readonly />
            </div>
            <div id="selectedImagePreview" class="selected-image-preview" style="display:none;">
                <img id="previewImage" src="" alt="Önizleme" />
            </div>
        </div>
        
        <button class="open-manager-btn" onclick="openFileManager()">
            📁 Dosya Yöneticisini Aç
        </button>
        
        <div class="features">
            <h3>Özellikler</h3>
            <ul>
                <li>Çoklu dosya yükleme</li>
                <li>Drag & Drop desteği</li>
                <li>Dosya önizleme (180x100)</li>
                <li>Görsel kırpma ve boyutlandırma</li>
                <li>Klasör yönetimi (alt klasör desteği)</li>
                <li>Çift tık ile dosya seçimi</li>
                <li>Görselleri gerçek boyutunda görüntüleme</li>
                <li>1 saniye loading ekranı ile kullanıcı bildirimi</li>
                <li>Smooth folder seçim animasyonu</li>
            </ul>
        </div>
    </div>

    @await Html.PartialAsync("_FileManagerPartial")
    
    <script>
        // ImageURL değiştiğinde önizleme göster
        document.getElementById('ImageURL').addEventListener('input', function() {
            const url = this.value;
            const preview = document.getElementById('selectedImagePreview');
            const img = document.getElementById('previewImage');
            
            if (url && (url.endsWith('.jpg') || url.endsWith('.jpeg') || url.endsWith('.png') || url.endsWith('.gif') || url.endsWith('.webp'))) {
                img.src = url;
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    </script>
</body>
</html>
